PORT=3001
NODE_ENV=development
ADMIN_FRONTEND_URL=http://localhost:5173
USER_FRONTEND_URL=http://localhost:5174

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=match_skill_app
