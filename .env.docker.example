# Copy this file to .env.database before starting Docker Compose.
MARIADB_ROOT_PASSWORD=replace-with-a-strong-root-password
MARIADB_PASSWORD=replace-with-a-strong-app-password
JWT_SECRET=replace-with-at-least-32-random-characters

# Local URLs exposed by compose.yaml
ADMIN_FRONTEND_URL=http://localhost:5173
USER_FRONTEND_URL=http://localhost:5174
NODE_ENV=development

# Optional development administrator
DEV_ADMIN_EMAIL=admin@matchskill.com
DEV_ADMIN_PASSWORD=replace-with-at-least-8-characters
DEV_ADMIN_NAME=Local Administrator
